{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tulungagung-dev",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./src/worker.ts",
  "queues": {
    "producers": [
      {
        "binding": "REGISTER_QUEUE",
        "queue": "registration-spreadsheet",
      },
    ],
    "consumers": [
      {
        "queue": "registration-spreadsheet",
      },
    ],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
}
