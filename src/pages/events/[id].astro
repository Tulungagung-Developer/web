---
import { getCollection, render } from "astro:content";
import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  CalendarDays,
  CheckCircle2,
  MapPin,
} from "lucide-react";
import MainLayout from "@/layouts/main-layout.astro";
import { formatDateId } from "@/lib/date";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const entries = await getCollection("events");
const { entry } = Astro.props;

const { Content } = await render(entry);

const endingAt = entry.data.endDate ?? entry.data.date;
const isPast = endingAt.valueOf() < Date.now();

const event = {
  id: entry.id,
  ...entry.data,
  dateText: formatDateId(entry.data.date),
  endDateText: entry.data.endDate
    ? formatDateId(entry.data.endDate)
    : undefined,
  subtitle: entry.data.subtitle ?? entry.data.excerpt,
};

const relatedEvents = entries
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((item) => ({
    id: item.id,
    title: item.data.title,
    category: item.data.category,
    date: formatDateId(item.data.date),
    location: item.data.location,
    image: item.data.image,
  }));
---

<MainLayout
  title={event.title}
  description={event.subtitle}
  image={event.image}
>
  <div class="min-h-screen bg-background pb-section pt-16 md:pb-section-lg">
    <section class="border-b border-border">
      <div class="mx-auto max-w-7xl px-5 pb-12 pt-6 md:px-8 md:pb-14 md:pt-8">
        <a
          href="/events"
          class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          <ArrowLeft size={16} />
          Semua kegiatan
        </a>

        <div
          class="mt-7 grid gap-8 lg:grid-cols-split lg:items-center lg:gap-12"
        >
          <div class="motion-preset-fade">
            <div class="flex flex-wrap items-center gap-2">
              <span
                class="rounded-full bg-accent px-3 py-1.5 text-xs font-semibold text-accent-foreground"
              >
                {event.category}
              </span>
              <span
                class:list={[
                  "inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold",
                  isPast
                    ? "bg-muted text-muted-foreground"
                    : "bg-primary/10 text-primary",
                ]}
              >
                <span
                  class:list={[
                    "h-1.5 w-1.5 rounded-full",
                    isPast ? "bg-muted-foreground" : "bg-primary",
                  ]}></span>
                {isPast ? "Selesai" : "Akan datang"}
              </span>
            </div>

            <h1
              class="mt-4 text-balance font-display text-4xl font-semibold leading-display tracking-display text-foreground md:text-6xl"
            >
              {event.title}
            </h1>
            <p
              class="mt-4 max-w-2xl text-lg leading-7 text-muted-foreground md:leading-8"
            >
              {event.subtitle}
            </p>

            <div
              class="mt-7 grid gap-4 border-y border-border py-5 sm:grid-cols-2"
            >
              <div class="flex items-start gap-3">
                <div
                  class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-accent text-primary"
                >
                  <CalendarDays size={19} />
                </div>
                <div>
                  <p
                    class="text-xs font-semibold tracking-meta text-muted-foreground"
                  >
                    Tanggal
                  </p>
                  <p class="mt-1 text-sm font-semibold text-foreground">
                    {event.dateText}{
                      event.endDateText ? ` sampai ${event.endDateText}` : ""
                    }
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-accent text-primary"
                >
                  <MapPin size={19} />
                </div>
                <div>
                  <p
                    class="text-xs font-semibold tracking-meta text-muted-foreground"
                  >
                    Lokasi
                  </p>
                  <p class="mt-1 text-sm font-semibold text-foreground">
                    {event.location}
                  </p>
                  {
                    event.venue && (
                      <p class="mt-0.5 text-sm text-muted-foreground">
                        {event.venue}
                      </p>
                    )
                  }
                </div>
              </div>
            </div>

            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
              {
                !isPast && event.registrationUrl ? (
                  <a
                    href={event.registrationUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
                  >
                    Daftar kegiatan
                    <ArrowUpRight size={17} />
                  </a>
                ) : (
                  <a
                    href="/events"
                    class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
                  >
                    Lihat kegiatan lain
                    <ArrowRight size={17} />
                  </a>
                )
              }
              <a
                href="/join"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-card px-5 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
              >
                Bergabung dengan komunitas
              </a>
            </div>
          </div>

          <figure
            class="overflow-hidden rounded-2xl border border-border bg-muted motion-preset-fade motion-delay-100"
          >
            <img
              src={event.image}
              alt={`Dokumentasi ${event.title}`}
              class="aspect-card w-full object-cover"
              fetchpriority="high"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-section md:px-8 md:py-section-lg">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-12">
        <div>
          <h2
            class="font-display text-3xl font-semibold tracking-tight text-foreground"
          >
            Tentang kegiatan ini
          </h2>
          <article
            class="prose prose-lg mt-6 max-w-3xl prose-headings:font-display prose-headings:font-semibold prose-headings:text-foreground prose-p:leading-8 prose-p:text-muted-foreground prose-a:text-primary prose-strong:text-foreground prose-li:text-muted-foreground prose-li:marker:text-primary prose-blockquote:border-primary/30 prose-blockquote:text-muted-foreground prose-hr:border-border"
          >
            <Content />
          </article>
        </div>

        <aside
          class="h-fit rounded-xl border border-border bg-card p-6 lg:sticky lg:top-28"
        >
          <div
            class="grid h-11 w-11 place-items-center rounded-lg bg-accent text-primary"
          >
            <CheckCircle2 size={21} />
          </div>
          <h2 class="mt-5 font-display text-xl font-semibold text-foreground">
            {isPast ? "Kegiatan telah selesai" : "Siap untuk bergabung?"}
          </h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            {
              isPast
                ? "Temukan agenda komunitas berikutnya dan terus terhubung dengan anggota lainnya."
                : "Amankan tempatmu dan dapatkan informasi teknis melalui kanal komunitas."
            }
          </p>
          <a
            href={isPast ? "/events" : (event.registrationUrl ?? "/join")}
            class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90"
          >
            {
              isPast
                ? "Jelajahi agenda"
                : event.registrationUrl
                  ? "Daftar sekarang"
                  : "Masuk komunitas"
            }
            <ArrowUpRight size={16} />
          </a>
        </aside>
      </div>
    </section>

    {
      relatedEvents.length > 0 && (
        <section class="border-t border-border bg-card py-section md:py-section-lg">
          <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="flex items-end justify-between gap-5">
              <div>
                <h2 class="font-display text-3xl font-semibold tracking-tight text-foreground">
                  Lanjutkan menjelajah.
                </h2>
              </div>
              <a
                href="/events"
                class="hidden text-sm font-semibold text-primary hover:text-primary/80 sm:inline-flex"
              >
                Semua kegiatan
              </a>
            </div>

            <div class="mt-7 grid gap-5 md:grid-cols-3">
              {relatedEvents.map((related) => (
                <a href={`/events/${related.id}`} class="group block">
                  <div class="overflow-hidden rounded-xl border border-border bg-muted">
                    <img
                      src={related.image}
                      alt={related.title}
                      class="aspect-card w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  </div>
                  <div class="mt-3 flex items-center gap-2 text-xs font-semibold tracking-meta text-primary">
                    <span>{related.category}</span>
                    <span class="h-1 w-1 rounded-full bg-border" />
                    <span class="text-muted-foreground">{related.date}</span>
                  </div>
                  <h3 class="mt-2 font-display text-lg font-semibold text-foreground transition-colors group-hover:text-primary">
                    {related.title}
                  </h3>
                  <p class="mt-2 inline-flex items-center gap-1.5 text-sm text-muted-foreground">
                    <MapPin size={14} /> {related.location}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</MainLayout>
