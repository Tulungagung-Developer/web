---
import { getCollection } from "astro:content";
import { Search } from "lucide-react";
import { Input } from "@/components/ui/input";
import EmptyState from "@/components/astro/empty-state.astro";
import ArticlesFilter from "@/islands/articles-filter";
import MainLayout from "@/layouts/main-layout.astro";
import { formatDateId } from "@/lib/date";

const entries = await getCollection("articles");

const articles = entries
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    author: entry.data.author,
    role: entry.data.role,
    date: formatDateId(entry.data.date),
    readTime: entry.data.readTime,
    category: entry.data.category,
    image: entry.data.image,
    featured: entry.data.featured,
  }));
---

<MainLayout title="Artikel">
  <div
    class="min-h-screen bg-background px-5 pb-section pt-28 md:px-8 md:pb-section-lg md:pt-32"
  >
    <div class="container mx-auto max-w-7xl">
      <!-- Header -->
      <div
        class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end"
      >
        <div>
          <h1
            class="mb-4 font-display text-5xl font-semibold tracking-hero text-foreground motion-preset-fade md:text-6xl"
          >
            Artikel
          </h1>
          <p
            class="max-w-xl text-lg leading-7 text-muted-foreground motion-preset-fade motion-delay-100 md:leading-8"
          >
            Tulisan dan pengalaman praktis dari orang-orang yang belajar,
            bekerja, dan bertumbuh di komunitas Tulungagung Dev.
          </p>
        </div>

        {
          articles.length > 0 && (
            <div class="flex w-full flex-col gap-6 motion-preset-fade motion-delay-200 md:w-auto">
              <div class="relative">
                <Input
                  type="text"
                  placeholder="Cari artikel..."
                  className="w-full rounded-lg border-border bg-card py-2.5 pl-10 pr-4 text-sm focus:border-ring focus:ring-2 focus:ring-ring/20 md:w-64"
                />
                <Search
                  className="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground"
                  size={16}
                />
              </div>
            </div>
          )
        }
      </div>

      {
        articles.length === 0 ? (
          <EmptyState
            kind="articles"
            title="Belum ada artikel yang diterbitkan"
            description="Kami sedang menyiapkan tulisan pertama dari komunitas. Bergabunglah jika kamu ingin berbagi pengalaman, panduan, atau perspektif tentang teknologi."
            actionHref="/join"
            actionLabel="Daftar sebagai anggota"
          />
        ) : (
          <ArticlesFilter client:load articles={articles} />
        )
      }
    </div>
  </div>
</MainLayout>
