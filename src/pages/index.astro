---
import { getCollection } from "astro:content";
import { ArrowRight, ArrowUpRight, CalendarDays, MapPin } from "lucide-react";
import CommunityShowcase from "@/components/astro/community-showcase.astro";
import EmptyState from "@/components/astro/empty-state.astro";
import Hero from "@/components/astro/hero.astro";
import MainLayout from "@/layouts/main-layout.astro";
import { formatDateId } from "@/lib/date";
import { Image } from "astro:assets";
import communityTeam from "@/assets/images/common/community-team.webp";

const entries = await getCollection("articles");
const eventEntries = await getCollection("events");

const latestArticles = entries
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    category: entry.data.category,
    date: formatDateId(entry.data.date),
    readTime: entry.data.readTime,
  }));

const featuredEvents = eventEntries
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    date: formatDateId(entry.data.date),
    location: entry.data.location,
    category: entry.data.category,
  }));
---

<MainLayout title="Komunitas Teknologi Tulungagung">
  <Hero />

  <section class="border-b border-border bg-brand text-brand-foreground">
    <div
      class="mx-auto grid max-w-7xl divide-y divide-white/10 px-5 md:grid-cols-3 md:divide-x md:divide-y-0 md:px-8"
    >
      <div class="py-7 md:px-8 md:first:pl-0">
        <p class="font-display text-3xl font-semibold">200+</p>
        <p class="mt-1 text-sm text-brand-foreground/65">anggota aktif</p>
      </div>
      <div class="py-7 md:px-8">
        <p class="font-display text-3xl font-semibold">10+</p>
        <p class="mt-1 text-sm text-brand-foreground/65">
          kegiatan komunitas setiap tahun
        </p>
      </div>
      <div class="py-7 md:px-8 md:last:pr-0">
        <p class="font-display text-3xl font-semibold">Terbuka</p>
        <p class="mt-1 text-sm text-brand-foreground/65">
          untuk semua tingkat pengalaman
        </p>
      </div>
    </div>
  </section>

  <section class="py-section md:py-section-lg">
    <div
      class="mx-auto grid max-w-7xl items-center gap-8 px-5 md:px-8 lg:grid-cols-2 lg:gap-12"
    >
      <div class="overflow-hidden rounded-2xl border border-border bg-muted">
        <Image
          src={communityTeam}
          alt="Anggota Tulungagung Dev berfoto bersama"
          class="aspect-card w-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <h2
          class="text-balance font-display text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
        >
          Ruang lokal untuk membuka peluang yang <span
            class="font-serif font-normal italic tracking-normal"
            >lebih luas.</span
          >
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          Tulungagung Dev mempertemukan pengembang, desainer, mahasiswa, dan
          profesional teknologi untuk saling mendukung, bertukar pengetahuan,
          dan membangun karya yang bermanfaat.
        </p>
        <a
          href="/about"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary/80"
        >
          Tentang kami
          <ArrowRight size={17} />
        </a>
      </div>
    </div>
  </section>

  <CommunityShowcase />

  <section class="border-t border-border bg-card py-section md:py-section-lg">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
        <div>
          <div class="flex items-end justify-between gap-4 pb-5">
            <div>
              <h2 class="font-display text-2xl font-semibold text-foreground">
                Agenda komunitas
              </h2>
            </div>
            <a
              href="/events"
              class="text-sm font-semibold text-primary hover:text-primary/80"
              >Selengkapnya</a
            >
          </div>
          <div class="divide-y divide-border">
            {
              featuredEvents.length === 0 ? (
                <EmptyState
                  kind="events"
                  title="Belum ada agenda"
                  description="Kegiatan berikutnya sedang dipersiapkan. Daftar sebagai anggota untuk mendapatkan kabar terbaru."
                  actionHref="/join"
                  actionLabel="Daftar sebagai anggota"
                  compact
                />
              ) : (
                featuredEvents.map((event) => (
                  <a
                    href={`/events/${event.id}`}
                    class="group grid gap-3 py-5 sm:grid-cols-[1fr_auto]"
                  >
                    <div>
                      <p class="text-xs font-semibold text-primary">
                        {event.category}
                      </p>
                      <h3 class="mt-2 font-display text-lg font-semibold text-foreground transition-colors group-hover:text-primary">
                        {event.title}
                      </h3>
                      <div class="mt-3 flex flex-wrap gap-4 text-xs text-muted-foreground">
                        <span class="inline-flex items-center gap-1.5">
                          <CalendarDays size={14} /> {event.date}
                        </span>
                        <span class="inline-flex items-center gap-1.5">
                          <MapPin size={14} /> {event.location}
                        </span>
                      </div>
                    </div>
                    <ArrowUpRight
                      size={18}
                      className="mt-1 text-muted-foreground transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary"
                    />
                  </a>
                ))
              )
            }
          </div>
        </div>

        <div>
          <div class="flex items-end justify-between gap-4 pb-5">
            <div>
              <h2 class="font-display text-2xl font-semibold text-foreground">
                Artikel terbaru
              </h2>
            </div>
            <a
              href="/articles"
              class="text-sm font-semibold text-primary hover:text-primary/80"
              >Selengkapnya</a
            >
          </div>
          <div class="divide-y divide-border">
            {
              latestArticles.length === 0 ? (
                <EmptyState
                  kind="articles"
                  title="Belum ada artikel"
                  description="Tulisan dari komunitas sedang disiapkan. Nantikan pengalaman dan pengetahuan yang akan dibagikan di sini."
                  actionHref="/join"
                  actionLabel="Ikut berkontribusi"
                  compact
                />
              ) : (
                latestArticles.map((article) => (
                  <a href={`/articles/${article.id}`} class="group block py-5">
                    <p class="text-xs font-semibold text-primary">
                      {article.category}
                    </p>
                    <h3 class="mt-2 font-display text-lg font-semibold leading-snug text-foreground transition-colors group-hover:text-primary">
                      {article.title}
                    </h3>
                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted-foreground">
                      {article.excerpt}
                    </p>
                    <p class="mt-3 text-xs text-muted-foreground">
                      {article.date} · {article.readTime}
                    </p>
                  </a>
                ))
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 py-section md:px-8 md:py-section-lg">
    <div
      class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 rounded-2xl bg-brand px-6 py-8 text-brand-foreground md:flex-row md:items-center md:px-10 md:py-10"
    >
      <div>
        <h2
          class="max-w-2xl text-balance font-display text-3xl font-semibold tracking-tight md:text-4xl"
        >
          Temukan ruang untuk belajar dan <span
            class="font-serif font-normal italic tracking-normal"
            >tumbuh bersama.</span
          >
        </h2>
      </div>
      <a
        href="/join"
        class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-brand-foreground px-5 py-3 text-sm font-semibold text-brand hover:bg-brand-foreground/90"
      >
        Gabung sekarang
        <ArrowUpRight size={17} />
      </a>
    </div>
  </section>
</MainLayout>
