---
import { getCollection } from "astro:content";
import { ArrowUpRight, CalendarDays, MapPin } from "lucide-react";
import EmptyState from "@/components/astro/empty-state.astro";
import MainLayout from "@/layouts/main-layout.astro";
import { formatDateId } from "@/lib/date";

const entries = await getCollection("events");

const now = new Date();

const sorted = entries.sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const upcoming = sorted.filter((e) => e.data.date.valueOf() >= now.valueOf());
const past = sorted
  .filter((e) => e.data.date.valueOf() < now.valueOf())
  .reverse();
---

<MainLayout title="Agenda Komunitas">
  <div
    class="min-h-screen bg-background px-5 pb-section pt-28 md:px-8 md:pb-section-lg md:pt-32"
  >
    <div class="container mx-auto max-w-7xl">
      <header class="mb-10 max-w-3xl">
        <h1
          class="mb-4 font-display text-5xl font-semibold tracking-hero text-foreground motion-preset-fade md:text-6xl"
        >
          Agenda Komunitas
        </h1>
        <p
          class="max-w-2xl text-lg leading-7 text-muted-foreground motion-preset-fade motion-delay-100 md:leading-8"
        >
          Temukan pertemuan, lokakarya, dan sesi belajar yang terbuka untuk
          anggota Tulungagung Dev.
        </p>
      </header>

      {
        entries.length === 0 ? (
          <EmptyState
            kind="events"
            title="Belum ada agenda yang dijadwalkan"
            description="Pertemuan dan sesi belajar berikutnya sedang dipersiapkan. Daftar sebagai anggota untuk menerima informasi saat agenda baru tersedia."
            actionHref="/join"
            actionLabel="Daftar sebagai anggota"
          />
        ) : (
          <section class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <div class="mb-5 flex items-center justify-between gap-4">
            <h2 class="font-display text-2xl font-semibold text-foreground">
              Agenda mendatang
            </h2>
            <a
              href="/join"
              class="text-sm font-semibold text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-2"
            >
              Bergabung di Discord
              <ArrowUpRight size={16} />
            </a>
          </div>

          {
            upcoming.length === 0 ? (
              <div class="bg-card border border-border rounded-xl p-6 text-muted-foreground">
                Belum ada agenda yang dijadwalkan. Silakan bergabung di Discord
                untuk pembaruan.
              </div>
            ) : (
              <div class="space-y-6">
                {upcoming.map((event, idx) => (
                  <a
                    href={`/events/${event.id}`}
                    class="block rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary/40 motion-preset-fade"
                    style={`animation-delay: ${idx * 80}ms`}
                  >
                    <div class="flex flex-col gap-5 md:flex-row md:items-stretch">
                      <div class="h-44 w-full shrink-0 overflow-hidden rounded-lg border border-border/50 bg-muted md:h-auto md:w-56 md:self-stretch">
                        <img
                          src={event.data.image}
                          alt={event.data.title}
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <div class="min-w-0">
                        <p class="text-xs font-semibold text-primary">
                          {event.data.category}
                        </p>
                        <h3 class="mt-2 text-2xl font-display font-semibold text-foreground leading-tight">
                          {event.data.title}
                        </h3>
                        {event.data.subtitle && (
                          <p class="mt-2 text-sm text-muted-foreground">
                            {event.data.subtitle}
                          </p>
                        )}
                        <div class="mt-4 flex flex-wrap gap-4 text-sm text-muted-foreground">
                          <span class="inline-flex items-center gap-2">
                            <CalendarDays size={16} />
                            {formatDateId(event.data.date)}
                          </span>
                          <span class="inline-flex items-center gap-2">
                            <MapPin size={16} />
                            {event.data.location}
                          </span>
                        </div>
                        <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary">
                          Lihat detail
                          <ArrowUpRight size={16} />
                        </div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            )
          }
        </div>

        <aside class="lg:col-span-5">
          <h2 class="mb-5 font-display text-2xl font-semibold text-foreground">
            Agenda sebelumnya
          </h2>
          {
            past.length === 0 ? (
              <div class="bg-card border border-border rounded-xl p-6 text-muted-foreground">
                Belum ada agenda sebelumnya.
              </div>
            ) : (
              <div class="space-y-4">
                {past.slice(0, 6).map((event) => (
                  <a
                    href={`/events/${event.id}`}
                    class="block rounded-xl border border-border p-4 bg-card hover:bg-muted/40 hover:border-primary/30 transition-colors"
                  >
                    <p class="text-xs font-semibold text-primary">
                      {event.data.category}
                    </p>
                    <p class="mt-2 text-sm font-semibold text-foreground">
                      {event.data.title}
                    </p>
                    <p class="mt-2 text-xs text-muted-foreground">
                      {formatDateId(event.data.date)} • {event.data.location}
                    </p>
                  </a>
                ))}
              </div>
            )
          }
        </aside>
          </section>
        )
      }
    </div>
  </div>
</MainLayout>
