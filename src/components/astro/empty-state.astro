---
import { ArrowRight, CalendarDays, FileText } from "lucide-react";

interface Props {
  kind: "articles" | "events";
  title: string;
  description: string;
  actionHref?: string;
  actionLabel?: string;
  compact?: boolean;
}

const {
  kind,
  title,
  description,
  actionHref,
  actionLabel,
  compact = false,
} = Astro.props;
const Icon = kind === "articles" ? FileText : CalendarDays;
---

<div
  class:list={[
    "flex flex-col items-center justify-center rounded-2xl border border-dashed border-border bg-card text-center",
    compact ? "px-5 py-9" : "min-h-80 px-6 py-14 md:px-10",
  ]}
>
  <div class="grid size-12 place-items-center rounded-xl bg-accent text-primary">
    <Icon size={22} aria-hidden="true" />
  </div>
  <h2
    class:list={[
      "font-display font-semibold tracking-tight text-foreground",
      compact ? "mt-5 text-xl" : "mt-6 text-2xl md:text-3xl",
    ]}
  >
    {title}
  </h2>
  <p
    class:list={[
      "text-muted-foreground",
      compact
        ? "mt-2 max-w-md text-sm leading-6"
        : "mt-3 max-w-xl text-base leading-7",
    ]}
  >
    {description}
  </p>
  {
    actionHref && actionLabel && (
      <a
        href={actionHref}
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary/80"
      >
        {actionLabel}
        <ArrowRight size={16} aria-hidden="true" />
      </a>
    )
  }
</div>
